# Maintainer: Mario Martínez <mariojmt9 at gmail dot com>
# Template for the AUR package houra-bin. The release workflow fills in
# sha256sums from the release's SHA256SUMS and publishes it to the AUR.
pkgname=houra-bin
pkgver=0.2.0
pkgrel=1
pkgdesc='Time tracker for GNOME with a top-bar timer'
arch=('x86_64')
url='https://github.com/Majamato/houra'
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'glib2' 'glibc' 'libgcc' 'cairo' 'hicolor-icon-theme')
optdepends=('gnome-shell: top-bar timer and idle detection (GNOME 49 to 51)')
provides=('houra')
conflicts=('houra')
options=('!debug')
install=houra.install
source=("$url/releases/download/v$pkgver/houra-$pkgver-x86_64-linux.tar.xz")
sha256sums=('SKIP')

package() {
  cd "houra-$pkgver-x86_64-linux"
  install -Dm755 bin/houra "$pkgdir/usr/bin/houra"
  cp -dr --no-preserve=ownership share "$pkgdir/usr/"
  # GNOME Shell finds the extension's translations in /usr/share/locale.
  rm "$pkgdir/usr/share/gnome-shell/extensions/houra@majamato.github.io/locale"
  # Arch packages keep only non-standard licenses; GPL-3.0 is in licenses-common.
  rm -r "$pkgdir/usr/share/licenses"
}
